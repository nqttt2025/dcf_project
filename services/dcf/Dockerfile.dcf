# Use base image with common dependencies
# Base image must be built first: docker-compose build base
# Build argument for base image version
ARG BASE_VERSION=latest
FROM dcf-project-base:${BASE_VERSION}

# Build argument for version
ARG VERSION=latest
ENV APP_VERSION=${VERSION}

WORKDIR /app

# Copy project source code (these change frequently)
COPY src /app/src
COPY config /app/config
COPY data /app/data

# Copy service code
COPY services/dcf/main.py /app/main.py

# Create necessary directories
RUN mkdir -p /app/data/results /app/data/cache /app/logs/app /app/logs/docker

LABEL version="${VERSION}"
LABEL maintainer="DCF Project"

EXPOSE 8001

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001"]
